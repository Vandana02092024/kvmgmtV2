# Merge these PDF settings into /var/www/html/kvmgmt/.env on the Linux server.
# Do not replace the complete production .env with this file.
# Poppler/Tesseract locations verified from the server command output.
SALES_REPORT_PDF_POPPLER_PATH=/usr/bin
SALES_REPORT_PDF_PDFTOPPM_BINARY=pdftoppm
SALES_REPORT_PDF_PDFINFO_BINARY=pdfinfo
SALES_REPORT_PDF_TESSERACT_BINARY=/usr/bin/tesseract
SALES_REPORT_PDF_TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata
SALES_REPORT_PDF_LANGUAGE=eng

# Same reader settings used by the local implementation.
SALES_REPORT_PDF_DPI=400
SALES_REPORT_PDF_PSM=6
SALES_REPORT_PDF_MIN_CONFIDENCE=25
SALES_REPORT_PDF_SUMMARY_WIDTH_RATIO=0.68
SALES_REPORT_PDF_COMMAND_TIMEOUT=240
SALES_REPORT_PDF_MAX_PAGES=20
SALES_REPORT_PDF_MAX_FILE_SIZE_KB=20480

# After merging, run as the application's deployment user:
# cd /var/www/html/kvmgmt
# php artisan config:clear
